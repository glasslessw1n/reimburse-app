<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Reimbursement.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 品牌色只许出现在主题资源里（评估 P4：颜色零硬编码进控件），深浅各一份 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DropBorderBrush" Color="#E8734A" />
                    <SolidColorBrush x:Key="DropBackgroundBrush" Color="#14E8734A" />
                    <!-- 列表区白色毛玻璃：半透明白盖在 Mica 上，比系统默认灰底更轻 -->
                    <SolidColorBrush x:Key="GlassFillBrush" Color="#9AFFFFFF" />
                    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#12000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DropBorderBrush" Color="#F0956F" />
                    <SolidColorBrush x:Key="DropBackgroundBrush" Color="#26F0956F" />
                    <SolidColorBrush x:Key="GlassFillBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#1FFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
