<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Reimbursement.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Reimbursement.App"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    Title="报销助手">
    <!-- 注意：WinUI 的 Window 没有 Resources（WMC0011），模板挂在根 Grid 上 -->
    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop" DragLeave="Root_DragLeave">
        <Grid.Resources>
        <!-- 拖放反馈：下载图标的呼吸缩放（DragOver 触发，离开/放下复位） -->
        <Storyboard x:Key="DragPulseIn">
            <DoubleAnimation Storyboard.TargetName="DropIconTransform" Storyboard.TargetProperty="ScaleX"
                             To="1.18" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="DropIconTransform" Storyboard.TargetProperty="ScaleY"
                             To="1.18" Duration="0:0:0.15" />
        </Storyboard>
        <Storyboard x:Key="DragPulseOut">
            <DoubleAnimation Storyboard.TargetName="DropIconTransform" Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="DropIconTransform" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.2" />
        </Storyboard>
        <!-- 平铺票据行（未整理时） -->
        <DataTemplate x:Key="FlatBillTemplate">
            <Grid Padding="10,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock FontSize="13">
                        <Run Text="{Binding Title}" FontWeight="SemiBold" />
                        <Run Text=" " />
                        <Run Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="重试" FontSize="12" Padding="10,3"
                        Tag="{Binding SourceFile}" IsEnabled="{Binding CanRetry}"
                        Click="RowRetryBtn_Click" />
                <Button Grid.Column="2" Content="移除记录" FontSize="12" Padding="10,3"
                        Tag="{Binding Uid}" IsEnabled="{Binding CanDelete}"
                        ToolTipService.ToolTip="只删除识别记录，原文件保留"
                        Click="RowDeleteBtn_Click" />
            </Grid>
        </DataTemplate>

        <!-- 分组票据行（整理后）：左侧类别色条 + 类型/金额/日期/城市 -->
        <DataTemplate x:Key="GroupBillTemplate">
            <Grid Padding="6,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding TypeBrush}" CornerRadius="2" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock FontSize="13">
                        <Run Text="{Binding TypeName}" FontWeight="SemiBold" Foreground="{Binding TypeBrush}" />
                        <Run Text=" · " />
                        <Run Text="{Binding AmountText}" FontWeight="SemiBold" />
                        <Run Text=" " />
                        <Run Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding DateCityText}" FontSize="11.5" Opacity="0.8" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Content="重试" FontSize="12" Padding="10,3"
                        Tag="{Binding SourceFile}" IsEnabled="{Binding CanRetry}"
                        Click="RowRetryBtn_Click" />
                <Button Grid.Column="3" Content="移除记录" FontSize="12" Padding="10,3"
                        Tag="{Binding Uid}" IsEnabled="{Binding CanDelete}"
                        ToolTipService.ToolTip="只删除识别记录，原文件保留"
                        Click="RowDeleteBtn_Click" />
            </Grid>
        </DataTemplate>

        <!-- 行程分组标题行（点击展开/收起） -->
        <DataTemplate x:Key="TripHeaderTemplate">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="10,7"
                    Tag="{Binding GroupKey}" Click="GroupToggleBtn_Click">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="{Binding ToggleGlyph}" FontSize="11"
                              VerticalAlignment="Center" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Subtitle}" FontSize="12"
                               Opacity="0.75" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <local:BillTemplateSelector x:Key="BillSelector"
            FlatTemplate="{StaticResource FlatBillTemplate}"
            GroupTemplate="{StaticResource GroupBillTemplate}"
            HeaderTemplate="{StaticResource TripHeaderTemplate}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 快捷键不再用声明式 KeyboardAccelerator：挂在根 Grid 上会让悬停窗口任意位置都弹 "Ctrl+O"
             提示（用户 1.3.0 反馈），改由代码后置 KeyDown 统一处理（见 MainWindow.xaml.cs Root_KeyDown） -->

        <!-- 自定义标题栏（内容延伸进标题栏，Mica 透出） -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="44" Padding="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="Assets/AppIcon.png" Width="20" Height="20"
                   VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="报销助手" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="VersionLabel" Opacity="0.55" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <!-- 右侧 146px 留给系统标题栏按钮（最小化/最大化/关闭），避免自绘按钮被盖住 -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="0,0,146,0">
                <Button x:Name="HelpBtn" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="使用说明" Click="HelpBtn_Click"
                        AutomationProperties.Name="使用说明">
                    <FontIcon Glyph="&#xE897;" FontSize="15" />
                </Button>
                <Button x:Name="DiagBtn" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="诊断日志" Click="DiagBtn_Click"
                        AutomationProperties.Name="诊断日志">
                    <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                </Button>
                <Button x:Name="SettingsBtn" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="设置" Click="SettingsBtn_Click"
                        AutomationProperties.Name="设置">
                    <AnimatedIcon Width="16" Height="16">
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedSettingsVisualSource />
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <SymbolIconSource Symbol="Setting" />
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Padding="20,6,20,20" ColumnSpacing="18" RowSpacing="12">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="14" FromHorizontalOffset="0" />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 状态行：常驻地/模型/OCR 概要 -->
            <TextBlock x:Name="HomeLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

            <!-- 步骤指示 -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="18">
                <TextBlock x:Name="Step1Text" Text="1 · 导入票据" FontSize="13" />
                <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
                <TextBlock x:Name="Step2Text" Text="2 · 自动识别" FontSize="13" />
                <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
                <TextBlock x:Name="Step3Text" Text="3 · 整理检查" FontSize="13" />
                <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
                <TextBlock x:Name="Step4Text" Text="4 · 导出" FontSize="13" />
            </StackPanel>

            <!-- 左侧：会话列表（可展开看行程概要与金额，可删除） -->
            <Grid Grid.Row="2" Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="会话" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button x:Name="NewSessionBtn" Grid.Row="1"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="NewSessionBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="新建会话" />
                    </StackPanel>
                </Button>
                <ListView x:Name="SessionList" Grid.Row="2"
                          SelectionMode="Single"
                          Background="{ThemeResource GlassFillBrush}"
                          BorderBrush="{ThemeResource GlassStrokeBrush}"
                          BorderThickness="1" CornerRadius="8" Padding="4"
                          SelectionChanged="SessionList_SelectionChanged">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                            <RepositionThemeTransition />
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalAlignment="Stretch" Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Stretch" Padding="8,4">
                                <Expander.Header>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Opacity="0.65" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalText}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="6" Margin="2,4,2,2">
                                    <ItemsControl ItemsSource="{Binding Briefs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12"
                                                           Opacity="0.85" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="删除此会话" FontSize="12" Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Tag="{Binding Sid}" Click="SessionDeleteBtn_Click" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="3" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                           Text="每次报销建一个会话。点开会话可看行程与金额。把票据拖进窗口任意位置即可自动识别，不必先建会话。" />
                <Button x:Name="ClearSessionsBtn" Grid.Row="4" Content="清除全部会话"
                        FontSize="12" HorizontalAlignment="Left" Opacity="0.75"
                        Click="ClearSessionsBtn_Click" />
            </Grid>

            <!-- 右侧：工作区 -->
            <Grid Grid.Row="2" Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 反馈带：未配置提醒 / 操作结果 / 识别汇总（InfoBar 分级呈现，取代自绘横幅与日志广播） -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <InfoBar x:Name="LlmWarnInfo" IsOpen="False" IsClosable="False"
                             Severity="Warning" Title="尚未配置识别服务"
                             Message="填写 LLM 地址与 API Key 并测试连接后，才能自动识别票据。">
                        <InfoBar.ActionButton>
                            <Button Content="打开设置" Click="SettingsBtn_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="ResultInfo" IsOpen="False" Severity="Informational" />
                    <InfoBar x:Name="SummaryInfo" IsOpen="False" Severity="Success" Title="识别完成">
                        <InfoBar.ActionButton>
                            <Button x:Name="SummaryActionBtn" Content="下一步：整理"
                                    Click="SummaryActionBtn_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!-- 拖放区（整窗也可拖放，这里是视觉引导） -->
                <Border x:Name="DropZone" Grid.Row="1" CornerRadius="10" Padding="18"
                        BorderThickness="1.5" BorderBrush="{ThemeResource DropBorderBrush}"
                        Background="{ThemeResource DropBackgroundBrush}"
                        ToolTipService.ToolTip="把票据拖进来，或点击下方按钮选择文件（Ctrl+O）"
                        AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                        DragLeave="DropZone_DragLeave">
                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                        <FontIcon x:Name="DropIcon" Glyph="&#xE896;" FontSize="24"
                                  HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                  Foreground="{ThemeResource DropBorderBrush}">
                            <FontIcon.RenderTransform>
                                <CompositeTransform x:Name="DropIconTransform" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock Text="把票据拖到这里" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock FontSize="12" Opacity="0.7" HorizontalAlignment="Center"
                                   Text="PDF / JPG / PNG / BMP · 拖入后自动识别（扫描件走内置 OCR）· 窗口任意位置都能放" />
                        <Button x:Name="ImportBtn" Content="或点击选择文件（Ctrl+O）"
                                HorizontalAlignment="Center" Margin="0,6,0,0"
                                Click="ImportBtn_Click" />
                    </StackPanel>
                </Border>

                <!-- 操作条：状态机驱动的唯一主按钮 + 检查 + 导出菜单 -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrimaryBtn" Grid.Column="0"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="导入票据" Click="PrimaryBtn_Click" />
                    <Button x:Name="PreflightBtn" Grid.Column="1" Content="提交前检查"
                            Click="PreflightBtn_Click" />
                    <SplitButton x:Name="ExportSplit" Grid.Column="2" Content="导出"
                                 Click="ExportSplit_Click">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="完整打包 ZIP（明细表 + 整理好的票据文件夹）"
                                                Click="ZipBtn_Click" />
                                <MenuFlyoutItem Text="整合 PDF（所有票据排成 A4 打印版）"
                                                Click="ComposeBtn_Click" />
                                <MenuFlyoutItem Text="简单合并 PDF（原件按顺序拼起来）"
                                                Click="MergeBtn_Click" />
                                <MenuFlyoutItem Text="仅导出明细 Excel"
                                                Click="ExcelBtn_Click" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Name="OpenExportsBtn" Grid.Column="4" Content="打开导出文件夹"
                            Click="OpenExportsBtn_Click" />
                </Grid>

                <!-- 进度 -->
                <Grid x:Name="ProgressArea" Grid.Row="3" ColumnSpacing="10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="ProgressSpinner" Grid.Column="0" Width="18" Height="18"
                                  IsActive="False" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock x:Name="ProgressText" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                    <Button x:Name="CancelBtn" Grid.Column="2" Content="取消" Click="CancelBtn_Click" />
                </Grid>

                <!-- 票据区：空状态与列表二选一 -->
                <Grid Grid.Row="4">
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8A5;" FontSize="40" HorizontalAlignment="Center"
                                  Opacity="0.35" />
                        <TextBlock Text="还没有票据" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="把 PDF 或图片拖进窗口，或点击上方按钮选择文件，识别会自动开始。"
                                   Opacity="0.65" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="BillList" SelectionMode="None"
                              Background="{ThemeResource GlassFillBrush}"
                              BorderBrush="{ThemeResource GlassStrokeBrush}"
                              BorderThickness="1" CornerRadius="8" Padding="4"
                              ItemTemplateSelector="{StaticResource BillSelector}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                                <RepositionThemeTransition />
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- 使用说明：标题栏 ? 入口；首次启动自动展示一次（UiState.HelpSeen 记录） -->
        <TeachingTip x:Name="HelpTip" Title="使用说明" Subtitle="四步完成一次报销"
                     Target="{x:Bind HelpBtn}" PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True" Closed="HelpTip_Closed">
            <StackPanel Spacing="10" Margin="0,6,0,2">
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    <Run Text="1 · 导入  " FontWeight="SemiBold" />
                    <Run Text="把票据 PDF / 图片拖进窗口任意位置（或按 Ctrl+O 选择），松手就自动识别；扫描件走内置 OCR，不用先建会话。" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    <Run Text="2 · 核对  " FontWeight="SemiBold" />
                    <Run Text="识别结果在右侧按行程分组，点开分组逐张看类型与金额；识别错的可以「重试」，不属于本次报销的可以「移除记录」（原文件不会删）。" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    <Run Text="3 · 整理检查  " FontWeight="SemiBold" />
                    <Run Text="点蓝色主按钮「整理」生成行程与规范文件名，再点「提交前检查」查缺漏（缺发票、金额对不上等）。" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    <Run Text="4 · 导出  " FontWeight="SemiBold" />
                    <Run Text="「完整打包 ZIP」一次拿到明细表 + 整理好的票据文件夹；「导出」菜单里还有整合 PDF、简单合并 PDF 和单独的 Excel 明细。" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7">
                    <Run Text="小提示：" FontWeight="SemiBold" />
                    <Run Text="Ctrl+Enter 执行当前主操作；识别用的是「设置」里的模型，换了 Key 记得测试连接；数据只存本机（%APPDATA%\Reimbursement.Windows），仅识别时会把票据文字发给你配置的模型服务。" />
                </TextBlock>
            </StackPanel>
        </TeachingTip>
    </Grid>
</Window>
