<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Reimbursement.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Reimbursement.App"
    Title="报销助手">
    <Window.Resources>
        <!-- 平铺票据行（未整理时） -->
        <DataTemplate x:Key="FlatBillTemplate">
            <Grid Padding="6,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock FontSize="13">
                        <Run Text="{Binding Title}" FontWeight="SemiBold" />
                        <Run Text=" " />
                        <Run Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="重试" FontSize="12" Padding="10,3"
                        Tag="{Binding SourceFile}" IsEnabled="{Binding CanRetry}"
                        Click="RowRetryBtn_Click" />
                <Button Grid.Column="2" Content="删除" FontSize="12" Padding="10,3"
                        Tag="{Binding Uid}" IsEnabled="{Binding CanDelete}"
                        Click="RowDeleteBtn_Click" />
            </Grid>
        </DataTemplate>

        <!-- 分组票据行（整理后）：左侧类别色条 + 类型/金额/日期/城市 -->
        <DataTemplate x:Key="GroupBillTemplate">
            <Grid Padding="2,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding TypeBrush}" CornerRadius="2" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock FontSize="13">
                        <Run Text="{Binding TypeName}" FontWeight="SemiBold" Foreground="{Binding TypeBrush}" />
                        <Run Text=" · " />
                        <Run Text="{Binding AmountText}" FontWeight="SemiBold" />
                        <Run Text=" " />
                        <Run Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding DateCityText}" FontSize="11.5" Opacity="0.8" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Content="重试" FontSize="12" Padding="10,3"
                        Tag="{Binding SourceFile}" IsEnabled="{Binding CanRetry}"
                        Click="RowRetryBtn_Click" />
                <Button Grid.Column="3" Content="删除" FontSize="12" Padding="10,3"
                        Tag="{Binding Uid}" IsEnabled="{Binding CanDelete}"
                        Click="RowDeleteBtn_Click" />
            </Grid>
        </DataTemplate>

        <!-- 行程分组标题行（点击展开/收起） -->
        <DataTemplate x:Key="TripHeaderTemplate">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="6,6"
                    Tag="{Binding GroupKey}" Click="GroupToggleBtn_Click">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" FontSize="12"
                               VerticalAlignment="Center" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Subtitle}" FontSize="12"
                               Opacity="0.75" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <local:BillTemplateSelector x:Key="BillSelector"
            FlatTemplate="{StaticResource FlatBillTemplate}"
            GroupTemplate="{StaticResource GroupBillTemplate}"
            HeaderTemplate="{StaticResource TripHeaderTemplate}" />
    </Window.Resources>
    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="报销助手" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="HomeLabel" FontSize="12" Opacity="0.65" />
            </StackPanel>
            <Button x:Name="SettingsBtn" Grid.Column="1" Content="⚙ 设置"
                    VerticalAlignment="Center" Click="SettingsBtn_Click" />
        </Grid>

        <!-- 步骤指示 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Spacing="18">
            <TextBlock x:Name="Step1Text" Text="1 · 导入票据" FontSize="13" />
            <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
            <TextBlock x:Name="Step2Text" Text="2 · 自动识别" FontSize="13" />
            <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
            <TextBlock x:Name="Step3Text" Text="3 · 整理检查" FontSize="13" />
            <TextBlock Text="›" Opacity="0.4" VerticalAlignment="Center" />
            <TextBlock x:Name="Step4Text" Text="4 · 导出" FontSize="13" />
        </StackPanel>

        <!-- 左侧：会话列表（可展开看行程概要与金额，可删除） -->
        <Grid Grid.Row="2" Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="会话" FontSize="14" FontWeight="SemiBold" />
            <Button x:Name="NewSessionBtn" Grid.Row="1" Content="＋ 新建会话"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" Click="NewSessionBtn_Click" />
            <ListBox x:Name="SessionList" Grid.Row="2"
                     SelectionChanged="SessionList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Expander HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" Padding="8,4">
                            <Expander.Header>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Opacity="0.65" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="2,4,2,2">
                                <ItemsControl ItemsSource="{Binding Briefs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       Opacity="0.85" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="删除此会话" FontSize="12" Padding="10,4"
                                        HorizontalAlignment="Left"
                                        Tag="{Binding Sid}" Click="SessionDeleteBtn_Click" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                       Text="每次报销建一个会话。点开会话可看行程与金额。把票据拖进右侧区域即可自动识别，不必先建会话。" />
            <Button x:Name="ClearSessionsBtn" Grid.Row="4" Content="清除全部会话"
                    FontSize="12" HorizontalAlignment="Left" Opacity="0.75"
                    Click="ClearSessionsBtn_Click" />
        </Grid>

        <!-- 右侧：工作区 -->
        <Grid Grid.Row="2" Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 拖放区 -->
            <Border x:Name="DropZone" Grid.Row="0" CornerRadius="10" Padding="16"
                    BorderThickness="1.5" BorderBrush="#E8734A"
                    Background="#14E8734A"
                    AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📥 把票据拖到这里" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock FontSize="12" Opacity="0.7" HorizontalAlignment="Center"
                               Text="PDF / JPG / PNG / BMP · 拖入后自动识别（扫描件走内置 OCR）" />
                    <Button x:Name="ImportBtn" Content="或点击选择文件"
                            HorizontalAlignment="Center" Margin="0,6,0,0"
                            Click="ImportBtn_Click" />
                </StackPanel>
            </Border>

            <!-- 工具栏 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button x:Name="RecognizeBtn" Content="识别待处理" Margin="0,0,8,6" Click="RecognizeBtn_Click" />
                <Button x:Name="FinalizeBtn" Content="整理" Margin="0,0,8,6" Click="FinalizeBtn_Click" />
                <Button x:Name="PreflightBtn" Content="提交前检查" Margin="0,0,16,6" Click="PreflightBtn_Click" />
                <Button x:Name="ExcelBtn" Content="导出明细 Excel" Margin="0,0,8,6" Click="ExcelBtn_Click" />
                <Button x:Name="ComposeBtn" Content="整合 PDF" Margin="0,0,8,6" Click="ComposeBtn_Click" />
                <Button x:Name="MergeBtn" Content="简单合并" Margin="0,0,8,6" Click="MergeBtn_Click" />
                <Button x:Name="ZipBtn" Content="完整打包" Margin="0,0,8,6" Click="ZipBtn_Click" />
                <Button x:Name="OpenExportsBtn" Content="打开导出文件夹" Margin="0,0,0,6" Click="OpenExportsBtn_Click" />
            </StackPanel>

            <!-- 进度 -->
            <Grid x:Name="ProgressArea" Grid.Row="2" ColumnSpacing="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" />
                    <TextBlock x:Name="ProgressText" FontSize="12" Opacity="0.75" />
                </StackPanel>
                <Button x:Name="CancelBtn" Grid.Column="1" Content="取消" Click="CancelBtn_Click" />
            </Grid>

            <!-- 提交前检查结果横幅 -->
            <Border x:Name="PreflightBanner" Grid.Row="3" CornerRadius="8" Padding="12,8"
                    Background="#1E7B4F" Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreflightText" Grid.Column="0" Foreground="White"
                               FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="关闭" Click="PreflightCloseBtn_Click" />
                </Grid>
            </Border>

            <!-- 票据列表（未整理=平铺；整理后=按行程分组，可展开/收起，类别分色） -->
            <ListBox x:Name="BillList" Grid.Row="4"
                     ItemTemplateSelector="{StaticResource BillSelector}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 诊断日志（可折叠） -->
            <Expander x:Name="LogExpander" Grid.Row="5" Header="诊断日志" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Height="110" />
            </Expander>
        </Grid>

        <!-- 完成汇总横幅 -->
        <Border x:Name="SummaryBanner" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                CornerRadius="8" Padding="14,10" Background="#1E7B4F" Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Grid.Column="0" Foreground="White"
                           FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="SummaryActionBtn" Grid.Column="1" Content="下一步：整理"
                        Click="SummaryActionBtn_Click" />
                <Button x:Name="SummaryCloseBtn" Grid.Column="2" Content="关闭"
                        Click="SummaryCloseBtn_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
