<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Reimbursement.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="识别服务（LLM）" Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,6,0,0" />
            <TextBlock Text="服务商预设" />
            <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch"
                      SelectionChanged="ProviderBox_SelectionChanged" />
            <TextBox x:Name="BaseUrlBox" Header="API 地址（Base URL）" />
            <PasswordBox x:Name="ApiKeyBox" Header="API Key" />
            <TextBlock Text="模型" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModelBox" Grid.Column="0" IsEditable="True"
                          HorizontalAlignment="Stretch" />
                <Button x:Name="FetchBtn" Grid.Column="1" Content="拉取模型"
                        Click="FetchBtn_Click" />
                <Button x:Name="TestBtn" Grid.Column="2" Content="测试连接"
                        Click="TestBtn_Click" />
            </Grid>
            <TextBlock x:Name="LlmStatus" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Text="OCR 引擎" Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,10,0,0" />
            <ComboBox x:Name="OcrBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="内置 PaddleOCR（离线，默认）" />
                <ComboBoxItem Content="OXR 云端解析（增强，扫描件优先走云端）" />
                <ComboBoxItem Content="不用 OCR（仅 PDF 文本层）" />
            </ComboBox>
            <TextBox x:Name="OxrUrlBox" Header="OXR 服务地址" />
            <PasswordBox x:Name="OxrKeyBox" Header="OXR API Key（免费接口可留空）" />
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Text="注意：OXR 模式会把票据原件上传到该云端服务解析；介意原件离机时请用内置 PaddleOCR。" />

            <TextBlock Text="报销主数据" Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,10,0,0" />
            <TextBox x:Name="HomeBox" Header="常驻地城市（逗号分隔，如 重庆）" />
            <TextBox x:Name="BuyerBox" Header="购方名称（发票抬头）" />
            <TextBox x:Name="TaxBox" Header="购方税号" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                <Button x:Name="SaveBtn" Content="保存" Click="SaveBtn_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="取消" Click="CancelBtn_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
