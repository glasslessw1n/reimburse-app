<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Reimbursement.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 自包含部署：.NET 运行时与 Windows App Runtime 一并打包，
         目标机器零前置（不用预装任何运行时），解压/拷贝即可运行 -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Reimbursement.App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <!-- 注意：WinUI 的 PRI 任务程序集只随 Visual Studio 的 MSBuild 提供，独立 .NET SDK 不含，
         因此本工程须用 VS 的 msbuild 构建（见 Reimbursement.Windows/ci/windows.yml），
         纯 dotnet build 会在 MrtCore.PriGen.targets 报 MSB4062。 -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Reimbursement.Core.csproj" />
  </ItemGroup>
</Project>
