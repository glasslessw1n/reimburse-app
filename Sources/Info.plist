<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>报销整理</string>
	<key>CFBundleDisplayName</key>
	<string>报销整理</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.1.0</string>
	<key>CFBundleVersion</key>
	<string>210</string>
	<!-- Sparkle 自动更新：feed 为仓库 main 分支上的 appcast.xml（发版时由
	     generate_appcast 重新生成并提交）；更新包本体挂在各版本 GitHub Release。 -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/glasslessw1n/reimburse-app/main/appcast.xml</string>
	<!-- 下行填 Sparkle 工具 bin/generate_keys 输出的 EdDSA 公钥（在本机生成，
	     私钥存本机钥匙串、切勿入库）。占位符不替换，更新校验必然失败、
	     程序其余功能不受影响；正式分发种子版前必须替换。 -->
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_GENERATE_KEYS_PUBLIC_KEY</string>
	<!-- 内部工具：不弹首次「是否自动检查更新」询问，默认开启自动检查 -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSAppleScriptEnabled</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
